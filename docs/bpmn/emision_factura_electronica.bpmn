          <dc:Bounds x="766" y="36" width="120" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidarARCA_di" bpmnElement="Task_ValidarARCA">
        <dc:Bounds x="880" y="58" width="124" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ARCA_di" bpmnElement="End_ARCA">
        <dc:Bounds x="1040" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="998" y="36" width="120" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="168" y="540" />
        <di:waypoint x="204" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="266" y="498" />
        <di:waypoint x="266" y="260" />
        <di:waypoint x="358" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="482" y="260" />
