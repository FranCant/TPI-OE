        <dc:Bounds x="1198" y="218" width="124" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OK_di" bpmnElement="EndEvent_OK">
        <dc:Bounds x="1358" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1321" y="282" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Rechazo_di" bpmnElement="Task_Rechazo">
        <dc:Bounds x="1075" y="353" width="124" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CorregirRechazo_di" bpmnElement="Task_CorregirRechazo">
        <dc:Bounds x="1075" y="498" width="124" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_ARCA_di" bpmnElement="Start_ARCA">
        <dc:Bounds x="808" y="82" width="36" height="36" />
