<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_NexoTech" targetNamespace="http://nexotech.example/bpmn">
  <bpmn:message id="Message_Solicitud" name="Solicitud de CAE" />
  <bpmn:message id="Message_Respuesta" name="Respuesta de ARCA" />
  <bpmn:collaboration id="Collaboration_Facturacion">
    <bpmn:participant id="Participant_ARCA" name="ARCA (ex AFIP)" processRef="Process_ARCA" />
    <bpmn:participant id="Participant_Comercio" name="Comercio cliente de NexoTech" processRef="Process_Comercio" />
    <bpmn:messageFlow id="MessageFlow_Solicitud" name="Solicitud de CAE" sourceRef="Task_Solicitar" targetRef="Start_ARCA" />
    <bpmn:messageFlow id="MessageFlow_Respuesta" name="CAE o rechazo" sourceRef="End_ARCA" targetRef="Event_Respuesta" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ARCA" name="ARCA (ex AFIP)" isExecutable="false">
    <bpmn:startEvent id="Start_ARCA" name="Solicitud de CAE recibida">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_ARCA_msgdef" messageRef="Message_Solicitud" />
    </bpmn:startEvent>
    <bpmn:task id="Task_ValidarARCA" name="Validar el comprobante">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_ARCA" name="Respuesta enviada">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:messageEventDefinition id="End_ARCA_msgdef" messageRef="Message_Respuesta" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Start_ARCA" targetRef="Task_ValidarARCA" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_ValidarARCA" targetRef="End_ARCA" />
  </bpmn:process>
  <bpmn:process id="Process_Comercio" name="Comercio cliente de NexoTech" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Comercio">
      <bpmn:lane id="Lane_Sistema" name="Sistema NexoTech (Facturación Automatizada)">
        <bpmn:flowNodeRef>Task_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Armar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Solicitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Respuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Autorizo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rechazo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Vendedor" name="Vendedor del comercio">
        <bpmn:flowNodeRef>StartEvent_Pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorregirDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorregirRechazo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Pedido" name="Pedido listo para confirmar">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Confirmar" name="Confirmar pedido">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Validar" name="Validar datos fiscales del pedido">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Datos" name="¿Datos fiscales válidos?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CorregirDatos" name="Corregir datos fiscales">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Armar" name="Armar comprobante electrónico">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Solicitar" name="Solicitar autorización (CAE) a ARCA">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_Respuesta" name="Respuesta de ARCA">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_Respuesta_msgdef" messageRef="Message_Respuesta" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Autorizo" name="¿ARCA autorizó el comprobante?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Registrar" name="Registrar factura con su CAE">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_OK" name="Factura emitida y registrada">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Rechazo" name="Registrar rechazo y avisar al vendedor">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_CorregirRechazo" name="Corregir el motivo del rechazo">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Pedido" targetRef="Task_Confirmar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Confirmar" targetRef="Task_Validar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Validar" targetRef="Gateway_Datos" />
    <bpmn:sequenceFlow id="Flow_4" name="Sí" sourceRef="Gateway_Datos" targetRef="Task_Armar" />
    <bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="Gateway_Datos" targetRef="Task_CorregirDatos" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CorregirDatos" targetRef="Task_Validar" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Armar" targetRef="Task_Solicitar" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Solicitar" targetRef="Event_Respuesta" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Event_Respuesta" targetRef="Gateway_Autorizo" />
    <bpmn:sequenceFlow id="Flow_10" name="Sí" sourceRef="Gateway_Autorizo" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Registrar" targetRef="EndEvent_OK" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="Gateway_Autorizo" targetRef="Task_Rechazo" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Rechazo" targetRef="Task_CorregirRechazo" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CorregirRechazo" targetRef="Task_Armar" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Facturacion">
      <bpmndi:BPMNShape id="Participant_ARCA_di" bpmnElement="Participant_ARCA" isHorizontal="true" bioc:fill="#F2F2F2" bioc:stroke="#1F3864">
        <dc:Bounds x="40" y="20" width="1411" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Comercio_di" bpmnElement="Participant_Comercio" isHorizontal="true" bioc:fill="#FFFFFF" bioc:stroke="#1F3864">
        <dc:Bounds x="40" y="190" width="1411" height="430" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_di" bpmnElement="Lane_Sistema" isHorizontal="true" bioc:fill="#EAF1FB" bioc:stroke="#1F3864">
        <dc:Bounds x="70" y="190" width="1381" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Vendedor_di" bpmnElement="Lane_Vendedor" isHorizontal="true" bioc:fill="#FFF6E5" bioc:stroke="#1F3864">
        <dc:Bounds x="70" y="460" width="1381" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Pedido_di" bpmnElement="StartEvent_Pedido">
        <dc:Bounds x="132" y="522" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="562" width="100" height="28" />
